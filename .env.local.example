NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key>
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

NEXT_PUBLIC_APP_URL=http://localhost:3000

# n8n webhook para enviar mensajes manuales desde el panel (conversaciones)
N8N_WEBHOOK_URL=https://<n8n_host>/webhook/enviar-mensaje-panel
N8N_WEBHOOK_SECRET=<webhook_secret>

# Webhook principal del bot — simula comandos de WhatsApp para cambiar estado de pedidos
# (distinto de N8N_WEBHOOK_URL; este apunta al endpoint raíz del bot)
BOT_WEBHOOK_URL=https://<n8n_host>/webhook/<bot_webhook_id>
